# Obligatoria: la única llave de modelos. ColombIA y el enjambre pasan por aquí.
OPENROUTER_API_KEY=sk-or-v1-...

# Opcional: solo si corres el enjambre con ENJAMBRE=deepseek
# DEEPSEEK_API_KEY=sk-...

# Opcional: telemetría. Aplica antes seguridad/cerrar_supabase.sql
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Enjambre: glm (por defecto) o deepseek; agentes en paralelo
# ENJAMBRE=glm
# MAX_DEEPSEEK_AGENTS=20
